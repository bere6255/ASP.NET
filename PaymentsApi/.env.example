# Copy to .env and replace every placeholder with a unique local development value.
SQL_SA_PASSWORD=Change_me_SQL_123!
REDIS_PASSWORD=Change_me_Redis_123!
ConnectionStrings__Default=Server=localhost,1433;Database=PaymentsDb;User Id=sa;Password=Change_me_SQL_123!;TrustServerCertificate=True
Redis__ConnectionString=localhost:6379,password=Change_me_Redis_123!,abortConnect=false
RabbitMq__HostName=localhost
RabbitMq__UserName=payments
RabbitMq__Password=Change_me_Rabbit_123!
Jwt__Key=replace-with-a-random-secret-at-least-32-bytes-long
Jwt__Issuer=PaymentsApi
Jwt__Audience=PaymentsApi.Client
Cors__AllowedOrigins__0=https://localhost:5173
